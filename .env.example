# Settings for `docker compose` — copy to `.env` (never commit `.env`).
#
# Contributor setup (`docker compose up`, with docker-compose.override.yml):
# nothing here is needed; it runs locally with authentication off.
#
# Deployable server (`docker compose -f docker-compose.yml --profile accounts up`):
# fill in everything below. It runs as ENVIRONMENT=production and refuses to start
# with the defaults.

# --- Accounts -------------------------------------------------------------------
AUTH_ENABLED=true
# A long random value: python -c 'import secrets; print(secrets.token_urlsafe(64))'
# Left commented, the server refuses to start in production (it keeps the default).
# JWT_SECRET_KEY=
# The password of the `admin` account created at startup ("admin" is refused).
DUCTA_ADMIN_PASSWORD=

# --- Database (accounts and run history) ---------------------------------------
# The `accounts` profile starts PostgreSQL with this password; put the same one in
# DATABASE_URL. A shared server refuses accounts in SQLite.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://ducta:<POSTGRES_PASSWORD>@postgres:5432/ducta

# --- Network --------------------------------------------------------------------
# The host names users type (DNS-rebinding guard) and the origins allowed to call
# the API; comma-separated.
# ALLOWED_HOSTS=ducta.company.com
# CORS_ORIGINS=https://ducta.company.com

# --- Optional -------------------------------------------------------------------
# Signs Run Certificates (the server signs them; runs never see the key).
# DUCTA_CERTIFICATE_KEY=
# Environments always protected, whatever a project says (default prod,production).
# DUCTA_PROTECTED_ENVIRONMENTS=prod,production

# Ports on the host and log level.
# API_PORT=8000
# SPARK_UI_PORT=4040
# LOG_LEVEL=INFO
